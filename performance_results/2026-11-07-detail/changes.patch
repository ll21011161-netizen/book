+/// Detail-only route: regular navigation fades without moving the whole page.
+/// Android predictive events use the framework route gesture lifecycle.
+class DetailRoute<T> extends MaterialPageRoute<T> {
+  DetailRoute({required BuildContext context, required Widget page})
+      : _reduced = MediaQuery.disableAnimationsOf(context),
+        super(
+            builder: (_) => page,
+            allowSnapshotting: false,
+            settings: const RouteSettings(name: 'library_detail')) {
+    if (PerfLog.enabled) _watch.start();
+  }
+  final bool _reduced;
+  final Stopwatch _watch = Stopwatch();
+  bool _firstFrameScheduled = false;
+  static final _fade = CurveTween(curve: AppConstants.detailCurve);
+
+  @override
+  Duration get transitionDuration =>
+      _reduced ? Duration.zero : AppConstants.detailEnterDuration;
+  @override
+  Duration get reverseTransitionDuration =>
+      _reduced ? Duration.zero : AppConstants.detailExitDuration;
+  @override
+  bool canTransitionFrom(TransitionRoute<dynamic> previousRoute) => false;
+  @override
+  DelegatedTransitionBuilder? get delegatedTransition => null;
+
+  @override
+  Widget buildPage(BuildContext context, Animation<double> animation,
+      Animation<double> secondaryAnimation) {
+    if (PerfLog.enabled && !_firstFrameScheduled) {
+      _firstFrameScheduled = true;
+      WidgetsBinding.instance.addPostFrameCallback((_) {
+        if (navigator != null) {
+          PerfLog.event('detail_route_first_frame',
+              {'elapsed_us': _watch.elapsedMicroseconds});
+        }
+      });
+    }
+    return super.buildPage(context, animation, secondaryAnimation);
+  }
+
+  @override
+  Widget buildTransitions(BuildContext context, Animation<double> animation,
+          Animation<double> secondaryAnimation, Widget child) =>
+      _DetailBackFade(
+          route: this,
+          animation: animation,
+          reduced: MediaQuery.disableAnimationsOf(context),
+          android: Theme.of(context).platform == TargetPlatform.android,
+          child: child);
+}
+
+/// Bridge Android's predictive events to the framework's public route gesture
+/// lifecycle. No snapshot, full-page scale, extra controller or native fallback
+/// transition is needed for this fade-only route.
+class _DetailBackFade extends StatefulWidget {
+  const _DetailBackFade(
+      {required this.route,
+      required this.animation,
+      required this.reduced,
+      required this.android,
+      required this.child});
+  final PageRoute<dynamic> route;
+  final Animation<double> animation;
+  final bool reduced, android;
+  final Widget child;
+  @override
+  State<_DetailBackFade> createState() => _DetailBackFadeState();
+}
+
+class _DetailBackFadeState extends State<_DetailBackFade>
+    with WidgetsBindingObserver {
+  late final Animation<double> _normal =
+      widget.animation.drive(DetailRoute._fade);
+  Animation<double>? _commit;
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  @override
+  bool handleStartBackGesture(PredictiveBackEvent event) {
+    if (!widget.android ||
+        widget.reduced ||
+        event.isButtonEvent ||
+        !widget.route.isCurrent ||
+        !widget.route.popGestureEnabled) {
+      return false;
+    }
+    _commit = null;
+    widget.route.handleStartBackGesture(progress: 1 - event.progress);
+    return true;
+  }
+
+  @override
+  void handleUpdateBackGestureProgress(PredictiveBackEvent event) =>
+      widget.route
+          .handleUpdateBackGestureProgress(progress: 1 - event.progress);
+  @override
+  void handleCancelBackGesture() {
+    _commit = null;
+    widget.route.handleCancelBackGesture();
+  }
+
+  @override
+  void handleCommitBackGesture() {
+    // The framework restarts the route's exit controller at 1 on commit. Map
+    // that value to the gesture's current opacity to avoid a one-frame flash.
+    _commit = widget.animation
+        .drive(Tween<double>(begin: 0, end: widget.animation.value));
+    widget.route.handleCommitBackGesture();
+  }
+
+  @override
+  Widget build(BuildContext context) => widget.reduced
+      ? widget.child
+      : FadeTransition(
+          opacity: widget.route.popGestureInProgress
+              ? (_commit ?? widget.animation)
+              : _normal,
+          child: widget.child);
+}
